rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: leaderboard
    // Document ID: userId
    // Fields:
    //   - username: string (required)
    //   - totalScore: number (required)
    //   - gamesPlayed: number (optional)
    //   - lastPlayed: timestamp (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "ranaramprajapat123456@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUserScore(data) {
      return data.keys().hasAll(['username', 'totalScore']) &&
             data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             data.totalScore is int && data.totalScore >= 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /leaderboard/{userId} {
      // Anyone can read the leaderboard
      allow read: if true;
      
      // Only the owner can create or update their score
      allow create: if isOwner(userId) && isValidUserScore(request.resource.data);
      allow update: if isOwner(userId) && isValidUserScore(request.resource.data) &&
                      request.resource.data.username == resource.data.username; // Username is immutable
      
      // Admins can do anything
      allow delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
